  "@graph": [
    {
      "id": "_:study",
      "label": {
        "en": "Research Cockpit: DMP Feedback Form"
      },
      "comment": {
        "en": "Survey form to evaluate the usability and fundability of the Data Management Plan templates inside the Research Cockpit (version revised from Sep. 2026). When you submit this form, it will not automatically collect your details like name and email address unless you provide it yourself."
      },
      "tue:collectionMode": "SelfAdministeredOnline",
      "tue:collectionPeriod": {
        "tue:startDate": "2026-04-30",
        "tue:endDate": "2026-05-13"
      },
      "tue:respondentCount": 74
    },
    {
      "id": "_:c1",
      "type": "cdi:Concept",
      "Concept-name": {
        "en": "Ease of finding DMP template"
      },
      "Concept-definition": {
        "en": "The perceived ease with which a respondent could locate the DMP template within the TU/e Research Cockpit."
      }
    },
    {
      "id": "_:c2",
      "type": "cdi:Concept",
      "Concept-name": {
        "en": "Ease of completing DMP"
      },
      "Concept-definition": {
        "en": "The perceived ease of the DMP completion process."
      }
    },
    {
      "id": "_:c3",
      "type": "cdi:Concept",
      "Concept-name": {
        "en": "Clarity of system instructions"
      },
      "Concept-definition": {
        "en": "The perceived clarity of instructions and guidance provided by the Research Cockpit system."
      }
    },
    {
      "id": "_:c4",
      "type": "cdi:Concept",
      "Concept-name": {
        "en": "Contact with data steward"
      },
      "Concept-definition": {
        "en": "Whether the respondent had contact with a data steward regarding their DMP."
      }
    },
    {
      "id": "_:c5",
      "type": "cdi:Concept",
      "Concept-name": {
        "en": "Helpfulness of data steward advice"
      },
      "Concept-definition": {
        "en": "The perceived helpfulness of the advice provided by the data steward, rated on a 5-star scale. Only applicable when the respondent had contact with a data steward."
      }
    },
    {
      "id": "_:c6",
      "type": "cdi:Concept",
      "Concept-name": {
        "en": "Suggested improvements to DMP experience"
      },
      "Concept-definition": {
        "en": "Free-text suggestions from the respondent for changing anything about the DMP experience. Only applicable when the respondent had contact with a data steward."
      }
    },
