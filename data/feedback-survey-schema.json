    {
      "id": "_:proc1",
      "type": "cdi:Activity",
      "Activity-name": { "en": "DMP Feedback Survey Administration Process" },
      "cdi:Activity-description": "Describes the survey flow, including conditional display of Q3 and Q4 based on the response to Q2.",
      "cdi:Activity_has_Step": [
        {
          "id": "_:step_q1",
          "type": "cdi:Step",
          "Activity-name": { "en": "Administer Q1 — Likert items" },
          "cdi:Activity-description": "Present the three Likert-scale statements to the respondent.",
          "cdi:Activity-entityUsed": [ { "id": "_:iv1" }, { "id": "_:iv2" }, { "id": "_:iv3" } ],
          "cdi:Activity-entityProduced": [ { "id": "_:iv1" }, { "id": "_:iv2" }, { "id": "_:iv3" } ]
        },
        {
          "id": "_:step_q2",
          "type": "cdi:Step",
          "Activity-name": { "en": "Administer Q2 — Data steward contact" },
          "cdi:Activity-description": "Present the Yes/No question about contact with a data steward.",
          "cdi:Activity-entityUsed": [ { "id": "_:iv4" } ],
          "cdi:Activity-entityProduced": [ { "id": "_:iv4" } ]
        },
        {
          "id": "_:step_q3",
          "type": "cdi:Step",
          "Activity-name": { "en": "Administer Q3 — Data steward helpfulness rating" },
          "cdi:Activity-description": "Present the 5-star rating question. This step is only executed if the ConditionalControlLogic evaluates to true (Q2 = Yes).",
          "cdi:Activity-entityUsed": [ { "id": "_:iv5" } ],
          "cdi:Activity-entityProduced": [ { "id": "_:iv5" } ]
        },
        {
          "id": "_:step_q4",
          "type": "cdi:Step",
          "Activity-name": { "en": "Administer Q4 — DMP improvement suggestion" },
          "cdi:Activity-description": "Present the free-text suggestion question. This step is only executed if the ConditionalControlLogic evaluates to true (Q2 = Yes).",
          "cdi:Activity-entityUsed": [ { "id": "_:iv6" } ],
          "cdi:Activity-entityProduced": [ { "id": "_:iv6" } ]
        }
      ],
      "cdi:Activity_hasInternal_ControlLogic": { "id": "_:skip_logic" }
    },

    {
      "id": "_:skip_logic",
      "type": "cdi:ConditionalControlLogic",
      "ControlLogic-name": { "en": "Show Q3 and Q4 if Q2 = Yes" },
      "cdi:ControlLogic-description": "A decision point that determines whether Q3 (data steward helpfulness rating) and Q4 (DMP improvement suggestion) are presented to the respondent. The condition evaluates the response to Q2 (InstanceVariable IV4: contact_data_steward). If the value equals code 1 (Yes) from CodeList CL_YESNO, Q3 and Q4 are displayed. Otherwise, they are skipped.",
      "ConditionalControlLogic-construct": "cdi:IfThen",
      "cdi:ControlLogic_invokes_Activity": [
        { "id": "_:step_q3" },
        { "id": "_:step_q4" }
      ],
      "tue:condition": {
        "tue:expression": "IV4.contact_data_steward == CodeList.CL_YESNO.Code['1']",
        "tue:expressionLanguage": "pseudo-human-readable",
        "tue:evaluatesVariable": { "id": "_:iv4" },
        "tue:evaluatesAgainstCodeList": { "id": "_:cl_yesno" },
        "tue:expectedCodeValue": "1",
        "expectedCategoryLabel": { "en": "Yes" }
      }
    }
  ]
}
