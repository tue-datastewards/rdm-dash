      "Concept-definition": { "en": "The perceived clarity of instructions and guidance provided by the Research Cockpit system." }
    },
    { "id": "_:c4", "type": "cdi:Concept",
      "Concept-name": { "en": "Contact with data steward" },
      "Concept-definition": { "en": "Whether the respondent had contact with a data steward regarding their DMP." }
    },
    { "id": "_:c5", "type": "cdi:Concept",
      "Concept-name": { "en": "Helpfulness of data steward advice" },
      "Concept-definition": { "en": "The perceived helpfulness of the advice provided by the data steward, rated on a 5-star scale. Only applicable when the respondent had contact with a data steward." }
    },
